        "background": {
          "canvas": "{color.ink.canvas}",
          "surface": "{color.ink.surface}",
          "subtle": "{color.ink.subtle}",
          "raised": "{color.ink.raised}",
          "inverse": "{color.neutral.100}",
          "overlay": "rgba(0, 0, 0, 0.6)"
