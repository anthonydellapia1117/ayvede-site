{
  "$description": "Authoritative token source for executive-ui. Primitives are raw values; semantic roles reference primitives with {path} and are defined per theme. scripts/build-tokens.mjs turns this file into dist/tokens.css and src/tokens/generated.ts. Edit this file only.",
  "meta": {
    "name": "executive-ui",
    "prefix": "eui",
    "themes": [
      "light",
      "dark"
    ],
    "themeAttribute": "data-theme"
  },
  "primitive": {
    "color": {
      "white": "#ffffff",
      "black": "#000000",
