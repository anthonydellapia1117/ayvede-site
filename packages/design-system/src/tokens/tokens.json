          "inverse": "{color.neutral.900}",
          "link": "{color.blue.300}",
          "onAction": "{color.white}",
          "onDanger": "{color.neutral.900}",
          "inverseSecondary": "{color.neutral.600}",
          "inverseTertiary": "{color.neutral.500}"
        },
        "border": {
          "default": "{color.ink.border}",
