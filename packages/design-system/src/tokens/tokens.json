    "font": {
      "family": {
        "sans": "\"Inter Variable\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"JetBrains Mono Variable\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "size": {
        "display": "clamp(2.25rem, 1.75rem + 2vw, 3.5rem)",
        "heading1": "clamp(1.875rem, 1.55rem + 1.3vw, 2.5rem)",
        "heading2": "clamp(1.5rem, 1.35rem + 0.6vw, 1.875rem)",
        "heading3": "clamp(1.25rem, 1.2rem + 0.25vw, 1.375rem)",
        "heading4": "1.0625rem",
        "lead": "clamp(1.125rem, 1.08rem + 0.25vw, 1.25rem)",
        "body": "1rem",
        "compact": "0.875rem",
        "meta": "0.8125rem",
        "eyebrow": "0.8125rem"
      },
      "lineHeight": {
        "display": "1.08",
        "heading": "1.18",
        "subheading": "1.3",
        "lead": "1.55",
        "body": "1.6",
        "compact": "1.45",
        "tight": "1.25"
      },
      "tracking": {
        "display": "-0.022em",
        "heading": "-0.014em",
        "subheading": "-0.006em",
        "normal": "0",
        "eyebrow": "0.06em"
      }
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    },
    "container": {
      "reading": "42rem",
      "content": "72rem",
      "wide": "90rem",
      "gutter": "clamp(1rem, 4vw, 2.5rem)"
    },
    "radius": {
      "none": "0",
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.625rem",
      "full": "999px"
    },
    "border": {
      "width": "1px",
      "widthStrong": "2px"
    },
    "control": {
      "sm": "2rem",
      "md": "2.5rem",
      "lg": "3rem",
      "touch": "2.75rem",
      "iconSm": "1rem",
      "iconMd": "1.25rem",
      "iconLg": "1.5rem"
    },
    "motion": {
      "fast": "120ms",
      "base": "180ms",
      "slow": "280ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
      "easeEmphasized": "cubic-bezier(0.3, 0, 0, 1)"
    },
    "z": {
      "base": "0",
      "raised": "1",
      "sticky": "100",
      "dropdown": "200",
      "overlay": "300",
      "modal": "400",
      "toast": "500"
    },
    "focus": {
      "width": "2px",
      "offset": "2px"
    }
  },
  "semantic": {
    "light": {
