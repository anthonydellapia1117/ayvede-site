        "700": "#353d49",
        "800": "#242a33",
        "900": "#161b22",
        "950": "#0f1218"
      },
      "ink": {
        "canvas": "#0f1218",
        "surface": "#161b22",
        "subtle": "#1b2129",
        "raised": "#1f262f",
        "border": "#2b333d",
        "borderStrong": "#64707f",
        "text": "#e8ebef",
        "textSecondary": "#aab3bf",
        "textTertiary": "#8b95a3",
        "textDisabled": "#5f6a78"
      },
      "blue": {
        "50": "#eef3fb",
