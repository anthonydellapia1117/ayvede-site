          "warningBorder": "{color.amber.200}",
          "danger": "{color.red.600}",
          "dangerSurface": "{color.red.50}",
          "dangerBorder": "{color.red.200}",
          "info": "{color.blue.700}",
          "infoSurface": "{color.blue.50}",
          "infoBorder": "{color.blue.200}",
          "neutral": "{color.neutral.600}",
          "neutralSurface": "{color.neutral.100}",
          "neutralBorder": "{color.neutral.300}"
        },
        "focus": {
          "ring": "{color.blue.600}"
        },
        "data": {
          "1": "{color.blue.600}",
          "2": "{color.neutral.500}",
          "3": "{color.green.600}",
          "4": "{color.amber.600}",
          "5": "{color.blue.300}",
          "6": "{color.neutral.300}"
        }
