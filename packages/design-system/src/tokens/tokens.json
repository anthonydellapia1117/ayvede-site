        "800": "#1e3876",
        "900": "#1a2e5e"
      },
      "green": {
        "50": "#e7f5ec",
        "200": "#a9dcbc",
        "400": "#5fc78f",
        "600": "#1e6b45",
        "800": "#1f5a3c",
        "900": "#12291d"
      },
      "amber": {
        "50": "#fdf3df",
        "200": "#f0cf87",
        "400": "#e3b04f",
        "600": "#8a5a00",
        "800": "#6b4f12",
        "900": "#2e2410"
      },
      "red": {
        "50": "#fdeceb",
        "200": "#f2b3ae",
        "400": "#f28b84",
        "600": "#b3261e",
        "800": "#7a2c27",
        "900": "#341a19"
      }
