{
  "name": "executive-ui",
  "version": "0.1.0",
  "description": "A brand-agnostic, executive-grade React design system: tokens, typography, controls, and decision-support content patterns.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "src/tokens/tokens.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshot.mjs",
    "check": "npm run typecheck && npm run build && npm run test && npm run build:preview"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axe-core": "^4.14.0",
    "esbuild": "0.24.2",
    "jsdom": "^30.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
