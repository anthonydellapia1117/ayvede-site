{
  "pkg": "executive-ui",
  "globalName": "ExecutiveUI",
  "projectId": "019dda8f-31a4-7a0e-ac9d-d36f7695f77e",
  "shape": "package",
  "buildCmd": "npm run build",
  "cssEntry": "dist/styles.css",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": [
    "docs/*.md"
  ],
  "provider": {
    "component": "ThemeProvider",
    "props": {
      "mode": "light"
    }
  },
  "componentSrcMap": {
    "RadioGroup": "src/components/controls/Radio.tsx",
    "Tab": "src/components/display/Tabs.tsx",
    "TabList": "src/components/display/Tabs.tsx",
    "TabPanel": "src/components/display/Tabs.tsx"
  },
  "overrides": {
    "Metric": {
      "cardMode": "column"
    },
    "ProcessDiagram": {
      "cardMode": "column"
    },
    "Timeline": {
      "cardMode": "column"
    },
    "NavBar": {
      "cardMode": "column",
      "viewport": "1100x700"
    },
    "Table": {
      "cardMode": "column"
    },
    "ComparisonTable": {
      "cardMode": "column"
    },
    "PageHeader": {
      "cardMode": "column"
    },
    "Section": {
      "cardMode": "column"
    },
    "Grid": {
      "viewport": "1100x700"
    },
    "Card": {
      "viewport": "1100x700"
    },
    "Container": {
      "viewport": "1700x700"
    },
    "DefinitionList": {
      "cardMode": "column"
    }
  },
  "libOverrides": {
    "dts.mjs": "declare referenced in-package types (TimelineStage, TableColumn, ...) in each .d.ts prelude; qualify bare React types; honest React.Ref<El> for ref"
  }
}
